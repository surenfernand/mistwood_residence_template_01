{
  "name": "mistwood-residence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file=.env server/index.js",
    "api": "node --trace-warnings --env-file=.env server/index.js",
    "api:watch": "node --watch --trace-warnings --env-file=.env server/index.js",
    "seed:bookings": "node --env-file=.env server/seed-bookings.js",
    "seed:apartment-gallery": "node --env-file=.env server/seed-apartment-gallery.js",
    "seed:apartment-gallery-videos": "node --env-file=.env server/seed-apartment-gallery-videos.js",
    "dev:all": "npx concurrently --kill-others-on-fail -n web,api -c blue,green \"npm run dev\" \"npm run api\"",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.10"
  },
  "packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34"
}
