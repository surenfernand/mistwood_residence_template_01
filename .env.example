DATABASE_URL=postgresql://user:password@127.0.0.1:5433/mistwood
PORT=3000
PUBLIC_SITE_URL=http://localhost:5173

# Used only when the admins table is empty for this email.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Mistwood Administrator

# PayHere (use sandbox until go-live).
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# Optional: external cron for stay lifecycle (otherwise runs daily in API process).
CRON_SECRET=

# Optional: Resend (instead of SMTP) for guest/admin email.
# RESEND_API_KEY=

# Optional: Google Calendar sync (not wired in UI until tokens are set).
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_REFRESH_TOKEN=

# SMTP — required for emails (see README.txt). Contact phone/email/deposit % live in Admin → Settings (database).
# Optional override for the SMTP From header (otherwise built from Settings mail-from name + contact email):
# MAIL_FROM=Mistwood Residence <owner@example.com>
